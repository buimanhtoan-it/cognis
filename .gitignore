# Cognis runtime state (local per-repository index, cache, leases, audit log)
.cognis/

# Editor-local MCP wiring (machine-specific paths)
.cursor/
.vscode/
.kiro/
.idea/

# Local portable editor binaries (never commit)
/cursor/

# Generated benchmark / evaluation / diagnostic artifacts
benchmark-reports/
.benchmarks/
audit.log
audit.log.*
diagnostics/

# Rust workspace build & distribution staging
/target/
/dist/

# VS Code / Cursor extension build & test artifacts
node_modules/
apps/cognis-mcp/.vscode/
apps/cognis-mcp/out/
apps/cognis-mcp/.vscode-test/
apps/cognis-mcp/.vscode-test-web/
apps/cognis-mcp/*.vsix

# Native shared libraries & symbols
*.dylib
*.dll
*.so
*.pdb

# Local secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Local logs, scratch helpers & databases
scratch_*
*.log
*.pid
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal
*.db-wal
*.db-shm
*.duckdb
*.duckdb-journal
*.idx
*.index
