!crates/cognis-store/tests/fixtures/uckg_oracle.db

# OS & editor swap files
*.swp
*.swo
*.bak
*.tmp
*.temp
*.orig
*.rej
.DS_Store
Thumbs.db
Desktop.ini

# ONNX model binaries (provisioned at release / runtime; README is tracked)
assets/models/**/*.onnx
assets/models/**/tokenizer.json
assets/models/**/pooling.json
assets/models/**/*.bin
assets/models/**/*.txt
assets/models/**/*.json
!assets/models/**/README.md

