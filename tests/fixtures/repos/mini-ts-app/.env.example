# Example environment for mini-ts-app fixture. NEVER put real secrets here.
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-me-in-real-deployments
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=mini-ts-app
JWT_AUDIENCE=mini-ts-app-clients
TOKEN_INTROSPECTION_URL=http://localhost:9999/introspect
TOKEN_INTROSPECTION_TIMEOUT_MS=2500
BCRYPT_COST=12
LOG_LEVEL=info
AUTH_DEBUG_DELAY_MS=0
